# СЕКРЕТЫ И ЛИЧНЫЕ ДАННЫЕ — никогда не в репозиторий.
# Журналы и CSV содержат номера счетов и балансы.

# --- НАЧАЛО БЛОКА ПРИВАТНОГО РЕЖИМА -------------------------------------
# Эти строки прячут config.py от git. Если репозиторий ПРИВАТНЫЙ и вы хотите
# хранить свои настройки и ключи прямо в нём — удалите строки между метками
# (это делает install/enable-private-mode.bat) и включите PRIVATE_MODE = True
# в config.py.
#
# ВКЛЮЧАТЬ ТОЛЬКО ПОСЛЕ ТОГО, КАК РЕПОЗИТОРИЙ СТАЛ ПРИВАТНЫМ.
config.py
ai_scalper_standalone/config.py
config.py.bak*
ai_scalper_standalone/config.py.bak*
config.py.sha256
ai_scalper_standalone/config.py.sha256
# --- КОНЕЦ БЛОКА ПРИВАТНОГО РЕЖИМА --------------------------------------

# Ниже — то, что остаётся вне git ВСЕГДА, при любом режиме.
# telegram_session — это живой пропуск в ваш Telegram: кто получит файл,
# войдёт в аккаунт без кода. accounts.json — логины и пароли счетов MT5.
# Закрытый репозиторий не повод класть туда действующие пропуска: доступ к
# нему могут получить соавторы, интеграции и сборочные скрипты.
.login_remember
ai_scalper_standalone/.login_remember
scalper.log
ai_scalper_standalone/scalper.log
*.log
trades_log.csv
ai_scalper_standalone/trades_log.csv
trades_log.csv.sha256
ai_scalper_standalone/trades_log.csv.sha256
accounts.json
ai_scalper_standalone/accounts.json
accounts.tmp
ai_scalper_standalone/accounts.tmp
learning_state.json
telegram_session
runtime_events.json
spread_baseline.json
