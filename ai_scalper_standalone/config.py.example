# =====================================================================
# СИГНАЛЫ ИЗ TELEGRAM
# =====================================================================
# ЧТО ЧУЖОЙ СИГНАЛ МОЖЕТ И ЧЕГО НЕ МОЖЕТ
#
# Автор сигнала не знает ни вашего депозита, ни ваших лимитов, ни уже
# открытых позиций. Поэтому сигнал НЕ МОЖЕТ: открыть сделку, увеличить лот
# или риск, отодвинуть стоп-лосс, отменить дневной лимит убытка или любой
# другой фильтр. Он может только добавить ограниченное число баллов к оценке
# и запретить вход. Это то же правило, что для ИИ-сигнала.
#
# ПОЧЕМУ НУЖЕН ВХОД ПОД ВАШИМ АККАУНТОМ, А НЕ БОТ
# Telegram запрещает ботам видеть сообщения других ботов ("Bots will not be
# able to see messages from other bots regardless of mode" —
# core.telegram.org/bots/faq). Сигналы от чужого бота приходят в ВАШ личный
# чат с ним, прочитать их может только клиент, вошедший под вашим аккаунтом.
TELEGRAM_ENABLED = False

# Бесплатно на https://my.telegram.org -> API development tools
TELEGRAM_API_ID = 0
TELEGRAM_API_HASH = ""

# Откуда читать: @имена ботов/каналов или числовые id чатов
TELEGRAM_SOURCES = []

# Роль сигнала:
#   "show"  — только показывать в программе, на торговлю НЕ влияет вообще.
#             Значение по умолчанию: подключение источника не должно молча
#             менять поведение бота.
#   "veto"  — плюс к показу: запрещает вход, противоречащий сигналу.
#   "score" — плюс к вето: совпавший сигнал добавляет баллы (с потолком ниже).
TELEGRAM_ROLE = "show"

# Потолок надбавки к оценке (0..100). Сверху жёстко ограничен 15 баллами в
# самом коде: даже если вписать сюда 500, чужой сигнал не сможет в одиночку
# протолкнуть сделку через порог входа.
TELEGRAM_MAX_SCORE_BONUS = 10.0

# Сколько минут сигнал считается свежим. Рекомендация часовой давности к
# текущему рынку отношения уже не имеет.
TELEGRAM_SIGNAL_TTL_MIN = 30

# Файл сессии Telegram (создаётся после первого входа). В .gitignore.
TELEGRAM_SESSION_PATH = "telegram_session"


# =====================================================================
# МОСТ ДЛЯ СОВЕТНИКОВ MQL5 — встроен в программу
# =====================================================================
# Советники спрашивают у моста режим рынка по HTTP. Раньше мост был
# отдельной программой со своими зависимостями (fastapi, uvicorn) и
# отдельным запуском. Теперь он живёт внутри программы: ставить и запускать
# отдельно нечего.
#
# БЕЗОПАСНОСТЬ: мост слушает ТОЛЬКО 127.0.0.1 — наружу не открывается ни при
# какой настройке, адрес привязки изменить нельзя.
#
# Ответ моста — ОГРАНИЧИТЕЛЬ: risk_multiplier 0.0-1.0, которым советник может
# только УМЕНЬШИТЬ объём. Увеличить риск или отменить лимит он не может.
#
# В терминале нужно один раз разрешить обращение к мосту:
# Сервис -> Настройки -> Советники -> "Разрешить WebRequest для"
# и добавить адрес http://127.0.0.1:8080
BRIDGE_ENABLED = False
BRIDGE_PORT = 8080
BRIDGE_CACHE_TTL_MIN = 45      # сколько минут держать ответ модели по символу


# =====================================================================
# ОБНОВЛЕНИЕ ИЗ GITHUB — без переустановки программы
# =====================================================================
# Правки кода уезжают на GitHub, а программа скачивает их сама.
#
# Советники (.mq5) обновляются БЕЗ перезапуска: это обычные файлы, их
# достаточно положить в терминал и пересобрать.
# Сама программа (.exe) требует перезапуска — работающий файл Windows держит,
# поэтому новая версия подменяется при следующем старте.
#
# Обновление не ставится молча ПОСРЕДИ РАБОТЫ. Автоматически оно применяется
# только при запуске, до начала торговли (UPDATE_AUTO_APPLY ниже). Если новая
# версия появилась, когда открыты позиции, программа спросит: подменять
# торгового робота под открытыми сделками нельзя.
#
# Репозиторий и проверка обновлений включены "из коробки" — программа всегда
# обновляется САМА СОБОЙ из того же репозитория, откуда приехала, вписывать
# ничего не нужно. Это безопасно ровно потому, что означает только "ПРОВЕРИТЬ,
# нет ли новой версии", а не "поставить её без спроса" — для этого отдельная
# галочка UPDATE_AUTO_APPLY, она по умолчанию выключена.
UPDATE_ENABLED = True
UPDATE_REPO = "simafon1-cyber/repp"   # владелец/название; свой форк — впишите сюда его
# Пусто = программа сама узнаёт у GitHub главную ветку репозитория
# (repo_default_branch() в updater.py). НЕ подставляйте сюда "main" вслепую:
# если в репозитории ветки main ещё нет (пока никто не сделал первый Pull
# Request — обычное дело для нового проекта), обновление отвечало бы
# "Репозиторий или ветка не найдены" на КАЖДЫЙ файл без понятной причины.
UPDATE_BRANCH = ""
# Токен нужен для ЗАКРЫТОГО репозитория: GitHub -> Settings ->
# Developer settings -> Personal access tokens -> Fine-grained -> ваш
# репозиторий. Права:
#   Contents: Read-only        — обычное обновление (обязательно);
#   Actions: Read and write    — если хотите, чтобы программа сама заказывала
#                                сборку .exe и забирала результат.
# Это секрет — хранится наравне с ключами API.
UPDATE_TOKEN = ""
UPDATE_INSTALLED_REV = ""      # заполняется программой после обновления
UPDATE_CHECK_ON_START = True   # проверять наличие обновлений при запуске

# Проверять обновления НЕ ТОЛЬКО при запуске, но и во время работы.
#
# Зачем: на сервере программа работает неделями и не перезапускается. Проверка
# «при запуске» в этом случае означает «никогда». 0 = выключить.
UPDATE_CHECK_MINUTES = 180


# =====================================================================
# НАСТРОЙКИ ТОРГОВЛИ ПРИХОДЯТ ИЗ GITHUB САМИ
# =====================================================================
# Владелец: «чтобы ты мог проверить в любой момент и изменить настройки
# торговли, и настройки сами загрузились без всяких нажатий».
#
# Программа читает файл remote/settings.json из репозитория обновлений и
# применяет его. Токен не нужен: репозиторий публичный, а читается один
# текстовый файл. Записать туда может только владелец репозитория.
#
# Перезапуск не нужен: настройки пишутся в этот самый config.py, а торговый
# цикл видит изменившийся файл и перечитывает его на ходу.
#
# ЧТО МОЖНО МЕНЯТЬ ЭТИМ СПОСОБОМ — строго ограниченный список в
# remote_settings.py: ручки торговли и ничего больше. Отдельно и намеренно
# ЗАПРЕЩЕНО менять источник обновлений (UPDATE_REPO/UPDATE_BRANCH), токены,
# пароли, логины и пути. Причина простая: разреши менять источник обновлений
# — и тот, кто получил доступ к репозиторию, подменит не настройку, а всю
# программу.
#
# Торговлю можно удалённо ВЫКЛЮЧИТЬ, но нельзя включить: остановка это
# защита, а запуск реальной торговли человек делает сам, у своего компьютера.
REMOTE_SETTINGS_ENABLED = True
REMOTE_SETTINGS_MINUTES = 10   # как часто заглядывать; 0 = только при запуске
REMOTE_SETTINGS_URL = ""       # пусто = remote/settings.json из UPDATE_REPO

# Ставить обновление САМО при запуске программы, ничего не спрашивая.
# Момент выбран не случайно: при старте торговля ещё не началась и открытых
# позиций у бота нет — подменять его в этот момент безопасно. Посреди работы
# обновление не применяется никогда, даже с этой галочкой.
# Ставить обновления САМО, без вопросов. Владелец: «сделай, чтобы она сама
# ставила обновление, без моего участия, чтобы корректировал через тебя, а
# она обновлялась».
#
# Когда это происходит:
#   * при запуске программы — торговля ещё не началась, открытых сделок нет;
#   * раз в UPDATE_CHECK_MINUTES во время работы, но ТОЛЬКО если открытых
#     сделок нет. Сделку ведут трейлинг и безубыток; остаться без них с
#     открытой позицией хуже, чем обновиться на несколько часов позже. Есть
#     сделки — установка просто откладывается до следующей проверки.
#
# Личные файлы (config.py, счета, сессия Telegram, журналы) обновление не
# трогает никогда — это отдельно проверяется тестами.
UPDATE_AUTO_APPLY = True

# Если готовой сборки .exe нет — попросить GitHub собрать её самому.
# Раньше это делалось руками: вкладка Actions -> Run workflow. Сборка идёт
# 5-10 минут, результат программа заберёт при следующей проверке.
# Требует у токена права Actions: Read and write.
UPDATE_REQUEST_BUILD = False


# =====================================================================
# ЖУРНАЛ СДЕЛОК В ОБЛАКЕ
# =====================================================================
# Раз в JOURNAL_UPLOAD_MINUTES программа выкладывает историю сделок в папку
# journal/ вашего ЗАКРЫТОГО репозитория GitHub, чтобы её можно было открыть
# с телефона или показать, когда рабочий компьютер выключен. Туда уходят
# три файла: собственный журнал бота, реальные закрытые сделки из MetaTrader
# и разбор обычными словами (винрейт, средний плюс/минус, сколько сделок
# умерло за секунды, какая пара даёт минус).
#
# ЧТО ТУДА НЕ ПОПАДАЕТ: пароли от счёта, ключи API, токены, сессия Telegram,
# config.py. Только сделки. Подробности — в cloud_journal.py.
#
# Выключено по умолчанию: программа не отправляет ничего наружу, пока вы
# сами это не включите.
JOURNAL_CLOUD_ENABLED = False
JOURNAL_REPO = ""              # пусто = тот же, что UPDATE_REPO
JOURNAL_BRANCH = "main"
# Токен GitHub с правом ЗАПИСИ: Settings -> Developer settings ->
# Personal access tokens -> Fine-grained -> ваш репозиторий ->
# Repository permissions -> Contents: Read and write.
# Отдельный от UPDATE_TOKEN намеренно: тому хватает чтения, и давать право
# записи там, где оно не нужно, — лишний риск. Это секрет.
JOURNAL_TOKEN = ""
JOURNAL_FOLDER = "journal"     # папка в репозитории
JOURNAL_UPLOAD_MINUTES = 15    # как часто выкладывать; вручную — кнопкой в программе
JOURNAL_MASK_ACCOUNT = False   # True = номер счёта в именах файлов как ****1234


# =====================================================================
# МИНИМАЛЬНАЯ ДИСТАНЦИЯ СТОП-ЛОССА
# =====================================================================
# Стоп считался как ATR x множитель профиля, и всё. У "Истерички" множитель
# 0.5, что на золоте M5 давало стоп около 1.8 пункта. При спреде 0.2-0.4 и
# обычном шуме в несколько пунктов такой стоп находится ВНУТРИ шума: сделки
# закрывались за 8-11 секунд, ни одна не доходила до цели.
#
# Эти два числа задают пол, ниже которого стоп не опускается ни при каком
# профиле. Расширение стопа обычно УМЕНЬШАЕТ лот (объём считается от риска в
# деньгах), поэтому риск в деньгах не растёт.
#
# ВАЖНАЯ ОГОВОРКА: это верно, только пока лот ЕСТЬ КУДА уменьшать. Если объём
# уже упёрся в минимальный лот брокера (0.01), уменьшать нечего — и тогда
# более широкий стоп увеличивает потерю в деньгах напрямую. Ровно так и вышло
# на счёте владельца: по золоту стоп расширился с ~2.0 до ~4.5 доллара цены, и
# риск одной сделки вырос с 3.1% до 6.9% счёта. Защищает от этого потолок
# MAX_TRADE_RISK_PERCENT_OF_EQUITY ниже — без него расширять стоп на малом
# депозите опасно.
MIN_SL_SPREAD_MULTIPLE = 8.0   # стоп не ближе 8 спредов
MIN_SL_ATR_FRACTION = 1.5      # и не ближе 1.5 ATR

# ПОТОЛОК РИСКА НА ОДНУ СДЕЛКУ, % от счёта. 0 = без потолка.
#
# Это не то же самое, что risk_percent в профиле. risk_percent — ЦЕЛЬ, под неё
# подбирается объём. Но ниже минимального лота брокера опуститься нельзя, и на
# маленьком депозите цель просто перестаёт действовать: реальный риск начинает
# определять цена инструмента, а не настройка.
#
# По реальному отчёту владельца (счёт $65, профиль «Истеричка», risk_percent
# 0.1%): золото минимальным лотом рисковало 6.9% счёта за сделку — в 69 раз
# больше настроенного. 37 сделок по золоту дали -29.56 при общем убытке
# -34.74, то есть 85% всех потерь на одном инструменте. Все остальные пары
# вместе потеряли -5.18, а GBPUSD оказался в плюсе.
#
# С потолком 2% такие сделки просто не открываются: инструмент, минимальный
# лот которого не помещается в этот процент, для данного депозита слишком
# дорог. На вкладке «Символы» в колонке «Риск лота» видно, почему отказ.
MAX_TRADE_RISK_PERCENT_OF_EQUITY = 2.0

# ПОТОЛОК ПЛЕЧА — ВЫКЛЮЧЕН ПО РЕШЕНИЮ ВЛАДЕЛЬЦА (0 = выключен).
#
# Ограничивает не потерю, а РАЗМЕР позиции относительно счёта: лот × размер
# контракта × цена не больше, чем equity × это число. Сделка при этом не
# отменяется, а уменьшается до допустимой.
#
# Зачем вообще нужен. Объём считается как риск ÷ расстояние-до-стопа, то
# есть чем УЖЕ стоп, тем БОЛЬШЕ лот. Когда волатильность падает, стоп
# сжимается и объём разносит. Потолок риска выше этого не ловит: он считает
# лот × расстояние до стопа и молча предполагает, что стоп исполнится ровно
# там, где стоит. У узкого стопа с огромным лотом это предположение и
# ломается — хватает расширения спреда.
#
# Что показал отчёт за 06-07.08.2026 (счёт $65). USDCAD днём: средний лот
# 0.029, средний убыток 0.43. Ночью: лот 0.147 (в 5 раз больше), убыток 2.46
# (в 5.7 раза больше). Лот 0.20 на счёте $65 — позиция $20 000, плечо 307:1.
# Все восемь сделок с лотом выше 0.065 дали вместе -6.58 при итоге -19.99.
#
# Владелец посмотрел эти цифры и решил оставить крупные лоты ради доходности
# — поэтому здесь 0. Поставьте 100 (плечо 100:1), чтобы включить: на счёте
# $65 это ограничит объём примерно 0.065 лота по валютным парам, дневные
# лоты 0.03-0.06 при этом не изменятся.
MAX_POSITION_LEVERAGE = 0

# Что делать, если МИНИМАЛЬНЫЙ лот брокера рискует больше, чем разрешает
# профиль. Так бывает на маленьком депозите: на счёте $100 минимальный лот
# 0.01 по золоту рискует ~2% вместо настроенных 0.1%.
#   True  - торговать всё равно, но громко писать в журнал реальный риск.
#   False - не открывать сделку. Честнее, но по "дорогим" инструментам
#           (золото, индексы) торговли на малом депозите не будет вовсе.
ALLOW_MIN_LOT_OVER_RISK = True


# =====================================================================
# ПАРАМЕТРЫ, КОТОРЫЕ ПОКАЗЫВАЕТ ИНТЕРФЕЙС
# =====================================================================
# КРИТИЧНО: Profit Lock не включается, пока прибыль не достигнет этой доли
# риска сделки. 1.0 = не раньше, чем прибыль сравняется со стопом. Ниже 1.0
# лок стартует РАНЬШЕ безубытка: сделка фиксируется в копеечный плюс, а
# неудачная теряет весь стоп — отсюда «мелкие плюсы, крупные минусы».
PROFIT_LOCK_START_R_FRACTION = 1.0

# Ступенчатая фиксация: чем выше был пик прибыли, тем большая его доля
# запирается стопом. Уровни — PROFIT_LOCK_TIERS ниже.
USE_TIERED_PROFIT_LOCK = True

# (во сколько раз пик выше порога старта, какой % пика запирать)
PROFIT_LOCK_TIERS = [(1.0, 40), (2.0, 60), (3.0, 75)]

# Как часто проверять УЖЕ открытые позиции между полными проходами по всем
# парам. Меньше — стоп ведётся точнее, но больше обращений к терминалу.
POSITION_MONITOR_SECONDS = 1.0
