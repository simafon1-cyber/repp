"""
config.py — все настройки автономного мульти-парного AI-скальпера.

Это САМОСТОЯТЕЛЬНАЯ программа (не MQL5-советник). Логика 1:1 портирована из
проекта AI Scalper Pro (MQL5, v8.0, папка "scalper"), но с тремя ключевыми
отличиями:
  1) Работает СРАЗУ по СПИСКУ инструментов (SYMBOLS ниже), а не по одному графику.
  2) Подключается к УЖЕ ОТКРЫТОМУ и залогиненному терминалу MT5 через
     MetaTrader5.initialize() — логин/пароль в коде не нужны.
  3) Экономический календарь MT5 (CalendarValueHistory) — это MQL5-only API,
     напрямую из Python он недоступен. Обходится сервисом CalendarExport
     (mql5/CalendarExport.mq5): он выгружает встроенный календарь терминала в
     файл, а программа его читает. Бесплатно, без ключа и без лимитов. Если
     сервис не запущен — цепочка NEWS_PROVIDER_CHAIN переключается на внешний
     API. Не ответил ни один источник — фильтр деградирует безопасно
     (fail-open): не блокирует и ничего не выдумывает, а вкладка "Календарь"
     честно показывает, что источника нет.

БЕЗОПАСНОСТЬ ПРЕВЫШЕ ВСЕГО: пока не убедишься на демо-счёте, что бот ведёт себя
ожидаемо, держи LIVE_TRADING = False. В этом режиме вся логика считается и
логируется, но ордера НЕ отправляются брокеру.
"""

from enum import Enum


# =====================================================================
# БЕЗОПАСНОСТЬ
# =====================================================================
LIVE_TRADING = True   # True = реальные ордера через MT5. False = сухой прогон (только лог).
POLL_SECONDS = 5      # Как часто опрашивать рынок (сек). Для скальпинга 5-15с достаточно.


# =====================================================================
# ПОДКЛЮЧЕНИЕ К БРОКЕРУ (MT5) — любой брокер с MT5-счётом
# =====================================================================
# По умолчанию (MT5_LOGIN = 0) программа подключается к УЖЕ ОТКРЫТОМУ и
# залогиненному терминалу MT5 на этом компьютере — так было изначально.
#
# Если заполнить MT5_LOGIN/MT5_PASSWORD/MT5_SERVER — программа сама запустит
# терминал и залогинится этими данными на ЛЮБОМ брокере, у которого есть
# MT5-счёт (терминал MetaTrader 5 всё равно должен быть установлен на этом
# компьютере — просто не обязательно держать его открытым и залогиненным
# заранее). Удобнее всего заполнять это через десктоп-приложение
# (desktop_app.py, панель "Брокер") — оно само впишет сюда нужные строки.
MT5_LOGIN = 0            # номер торгового счёта, 0 = использовать открытый терминал
MT5_PASSWORD = ''
MT5_SERVER = ""          # имя сервера брокера, например "SwitchMarkets-Live" (см. письмо брокера при регистрации счёта)
MT5_TERMINAL_PATH = ""   # путь к terminal64.exe, если MT5 установлен не в стандартную папку (обычно можно оставить пустым)

# Прятать окно терминала MetaTrader.
#
# Владелец: «чтобы не открывался сам терминал, чтобы я мог просто ввести
# учётные данные и работать в этой же программе».
#
# ЧТО ЭТО ДЕЛАЕТ. Программа и так запускает терминал сама и сама входит в
# счёт — логин, пароль и сервер передаются прямо при подключении, руками в
# MetaTrader вводить ничего не нужно. Эта настройка убирает с экрана ещё и
# окно: терминал продолжает работать полностью, просто не показывается.
#
# ЧЕГО ЭТО НЕ ДЕЛАЕТ. Совсем без терминала работать нельзя, и это не вопрос
# усилий. Терминал И ЕСТЬ соединение с брокером: он держит защищённый канал и
# исполняет приказы. Наша программа с брокером не разговаривает вовсе — она
# отдаёт команды терминалу. Протокол этого канала закрытый, MetaQuotes его не
# публикует, поэтому «встроить брокера в программу» невозможно в принципе.
#
# ВАЖНО ЗНАТЬ. Спрятанное окно исчезает и с панели задач: вернуть его мышью
# не получится. Окно возвращается само при выходе из программы, а до этого —
# кнопкой «Показать терминал MetaTrader» на вкладке «Система».
#
# Прячется только ПОСЛЕ успешного входа: если вход не удался, терминал может
# показывать ошибку, и спрятать его значило бы спрятать причину неполадки.
MT5_HIDE_TERMINAL = True


# =====================================================================
# ИНСТРУМЕНТЫ — впиши ТОЧНЫЕ названия как в Market Watch твоего брокера
# =====================================================================
# Имена пишутся БЕЗ суффикса брокера. Программа сама сопоставит их с тем,
# как пары называются у вашего брокера: EURUSD найдётся и как EURUSDs, и как
# EURUSD.a, и как EURUSDm (см. resolve_symbol в accounts.py). Раньше здесь
# стоял список с суффиксом "s" от конкретного брокера — на любом другом
# брокере не находилась НИ ОДНА пара, и бот молча не торговал ничем.
#
# Почему именно эти четыре. Они самые дешёвые в работе: узкий спред и
# небольшая цена минимального лота 0.01. Посчитано для депозита 65:
#   USDJPY  0.99% счёта риска на сделку     GBPUSD  1.84%
#   EURUSD  1.23%                           AUDUSD  1.84%
# А то, что стояло здесь раньше, для такого депозита недоступно:
#   XAUUSD (золото) 3.68% — 85% всех потерь по реальному отчёту владельца
#   BTCUSD          490%  — одна сделка минимальным лотом больше всего счёта
# Добавлять пары можно на вкладке «Символы». Слишком дорогую для депозита
# программа не откроет и объяснит почему (MAX_TRADE_RISK_PERCENT_OF_EQUITY).
SYMBOLS = ["EURUSD", "GBPUSD", "USDJPY", "AUDUSD"]

# Инструменты, выключенные НАСОВСЕМ — по прямой просьбе владельца
# («отключи торговлю золота»).
#
# Почему отдельный список, а не просто вычеркнуть из SYMBOLS. Список пар
# приходит из ЧЕТЫРЁХ мест сразу: SYMBOLS выше, поле symbols у каждого счёта
# в accounts.json, добавление руками на вкладке «Символы» и переключатель на
# дашборде. Вычеркнуть в одном месте — оставить три двери открытыми. Этот
# список проверяется на входе и закрывает все четыре.
#
# Имя сравнивается БЕЗ СУФФИКСА брокера: XAUUSD, XAUUSDs, XAUUSD.m, xau/usd —
# это всё золото. У разных брокеров одна пара называется по-разному.
#
# Запрет касается только НОВЫХ входов: уже открытая сделка продолжает
# вестись до конца — трейлинг, безубыток, частичное закрытие работают.
#
# Оговорка честности ради: при депозите 500-1000 золото перестаёт быть
# неподъёмным (риск минимального лота падает с 6.7% счёта до 0.44-0.87%).
# Оно выключено потому, что так решил владелец, а не потому, что не
# помещается. Убрать из списка можно в любой момент.
BLOCKED_SYMBOLS = ["XAUUSD"]

# =====================================================================
# ПРОГРАММА САМА ВЫБИРАЕТ ПАРЫ ИЗ СПИСКА БРОКЕРА
# =====================================================================
# Владелец: «чтобы список сам подгружался — всё, что есть у брокера, и он
# старался работать на всех парах».
#
# НА ВСЕХ НЕЛЬЗЯ, и это не лень. У брокера их сотни, а один проход стоит
# около 40 мс на пару: 300 пар превратили бы пятисекундный круг в
# двенадцатисекундный, и скальпер торговал бы по ценам двенадцатисекундной
# давности. Вторая причина важнее скорости: пары НЕ независимы. EURUSD,
# GBPUSD, AUDUSD и NZDUSD — это в основном ставка на доллар, и «десять разных
# сделок» легко оказываются одной ставкой, повторённой десять раз.
#
# Поэтому программа берёт ВЕСЬ список брокера и отбирает лучшие по признакам,
# которые можно посчитать: по карману ли минимальный лот, какую долю обычного
# движения съедает спред, есть ли вообще движение, разрешена ли торговля, и
# не набирается ли одна и та же валюта. Подробности — в symbol_picker.py.
#
# Это НЕ поиск прибыльных пар. Это отсев заведомо невыгодных — уменьшение
# расходов, а не предсказание дохода.
#
# Отбор идёт один раз при запуске. Выключить — False, тогда работает список
# SYMBOLS выше.
AUTO_PICK_SYMBOLS = True
AUTO_PICK_LIMIT = 0             # 0 = БЕЗ ПОТОЛКА: берём все подходящие пары
AUTO_PICK_MAX_SPREAD_RATIO = 0.25   # спред не больше 25% обычного движения
AUTO_PICK_PER_CURRENCY = 0      # 0 = не ограничивать СПИСОК по валютам

# СКОЛЬКО ВРЕМЕНИ ОТБОРУ ПОЗВОЛЕНО ЗАНЯТЬ ПРИ ЗАПУСКЕ. Это ограничение
# появилось не для красоты. Сначала отбор шёл по ВСЕМ парам брокера сразу за
# барами — а чтобы получить бары, пару надо добавить в «Обзор рынка», после
# чего терминал идёт за историей на сервер. На сотнях пар запуск растягивался
# на минуты, и владелец написал: «нет отклика от программы, виснет».
#
# Теперь отбор идёт в два этапа. Дешёвый: описание контракта (минимальный лот,
# цена пункта) — без баров и без «Обзора рынка». Дорогой: бары и спред, но
# только для тех, кто прошёл первый этап, и не больше SURVEY_LIMIT штук.
#
# Время ограничено жёстко: кончилось — берём то, что успели. Неполный список
# лучше запуска, который не кончается.
AUTO_PICK_SURVEY_LIMIT = 60     # сколько пар ЗАМЕРЯТЬ за один запуск
AUTO_PICK_MAX_SECONDS = 20      # дольше этого отбор при запуске не идёт
BASELINE_SEED_MAX_SECONDS = 15  # столько же на загрузку нормы спреда

# ЗАМЕРЫ ХРАНЯТСЯ В ФАЙЛЕ symbols_survey.json рядом с программой. Замеренная
# пара при следующем запуске не трогается вовсе — запуск получается мгновенным.
# То, что не успели замерить, дозамеряется при следующих запусках: за несколько
# раз покрывается весь список брокера, и ни один запуск не долгий.
# Записи старше суток обновляются понемногу, чтобы список не закостенел на
# ночных спредах. Подробности — в symbol_cache.py.

# ПОЧЕМУ ПОТОЛКА БОЛЬШЕ НЕТ. Сначала здесь стояло 20 пар: обход одной пары
# стоит около 40 мс, а круг задан POLL_SECONDS = 5 секунд. Потом выяснилось,
# что потолок был ненастоящим. Вход в сделку возможен ТОЛЬКО на новом баре, а
# рабочий таймфрейм M5 — новый бар раз в 300 секунд. То есть из шестидесяти
# обходов пары между барами пятьдесят девять заканчивались ничем.
#
# Теперь пары с открытой сделкой обходятся на КАЖДОМ проходе (там трейлинг-
# стоп, задержка стоит денег), а остальные — ПО ОЧЕРЕДИ, так чтобы весь
# список прокручивался за SCAN_ROTATE_SECONDS. Подробности — scan_rotation.py.
SCAN_ROTATE_SECONDS = 30        # за сколько секунд обойти весь список пар

# ЛЁГКИЙ ПРОХОД — главное ускорение программы. Самая дорогая работа в цикле:
# выкачать 300 баров и посчитать по ним все индикаторы. Замер: 8.4 мс на пару
# только на счёт, плюс сам запрос к терминалу. При этом вход в сделку возможен
# ТОЛЬКО на новом баре, а на M5 бар меняется раз в 300 секунд — то есть из
# шестидесяти проходов между барами пятьдесят девять эту работу выбрасывали.
#
# Смена бара теперь определяется делением по времени тика, который и так
# запрашивается: ни одного лишнего обращения к терминалу. Бар тот же и сделки
# по паре нет — проход заканчивается сразу.
#
# Пары с ОТКРЫТОЙ сделкой этот путь не проходят никогда: им нужен свежий ATR
# для трейлинг-стопа, и экономить там значило бы вести позицию вслепую.
USE_LIGHT_SCAN = True

# А ВОТ ЧТО ОГРАНИЧЕНО ПО-НАСТОЯЩЕМУ — сколько сделок с одной валютой можно
# держать ОДНОВРЕМЕННО. Пары не независимы: EURUSD, GBPUSD и AUDUSD — это в
# основном одна ставка против доллара. Четыре такие сделки выглядят как
# разложенный риск, но в день, когда доллар двинется против нас, все четыре
# стопа сработают вместе.
#
# Смотреть можно сколько угодно пар — это ничего не стоит. Платим мы только
# за одновременно открытые. 0 = не ограничивать (не советую).
MAX_POSITIONS_PER_CURRENCY = 3

# Оформление окна: "light" — светлая тема (по умолчанию), "dark" — тёмная.
# Раньше тема была только тёмная, и на чёрном фоне цифры в таблицах читались
# плохо. Обе темы проверены на контраст по WCAG (см. ui_theme.py).
UI_THEME = "light"

TIMEFRAME = "M5"         # рабочий ТФ для входов
TREND_TIMEFRAME = "M15"  # старший ТФ для MTF-тренда (должен быть СТАРШЕ TIMEFRAME)

MAGIC_NUMBER = 234567    # уникальный ID этой программы в позициях/истории


# =====================================================================
# ПРОФИЛИ РИСКА (портировано из RiskManager.mqh, ApplyRiskProfile)
# =====================================================================
class RiskProfile(Enum):
    CONSERVATIVE = "conservative"
    BALANCED = "balanced"
    AGGRESSIVE = "aggressive"
    HYSTERIC = "hysteric"  # "Истеричка" — почти без фильтров, но лоты/риск крошечные


# ПРОФИЛЬ ПО УМОЛЧАНИЮ ПРИ ЗАПУСКЕ ПРОГРАММЫ.
#
# Был HYSTERIC («Истеричка»), стал AGGRESSIVE («Агрессивный») — по решению
# владельца при переходе с депозита 65 на 500-1000.
#
# Что меняется:
#                        Истеричка      Агрессивный
#   риск на сделку          0.1%            1.2%
#   порог входа (score)      45              55        строже отбор
#   сделок на пару          до 10           до 5
#   мягкие фильтры       ОТКЛЮЧЕНЫ        ВКЛЮЧЕНЫ
#   стоп-лосс             1.5 x ATR        2.0 x ATR
#
# Последняя строка таблицы — главная. У «Истерички» стоит
# ignore_soft_filters = True, и это разом выключает ТРИ защиты:
# rollover_guard_ok (пауза вокруг полуночи брокера), volatility_ok (защита от
# скачка волатильности) и spread_cost_ok (спред не должен съедать больше 30%
# цели). На «Агрессивном» все три работают.
#
# Риск 0.1% на депозите 65 всё равно ничего не решал: расчёт просил меньше
# минимального лота брокера, и объём определял брокер, а не настройка. На
# 500-1000 процент начинает работать по-настоящему, поэтому и профиль имеет
# смысл выбрать осмысленно.
RISK_PROFILE = RiskProfile.AGGRESSIVE  # см. таблицу выше; менять на вкладке "Настройка"

# eff*-параметры на каждый профиль — те же цифры, что в MQL5 v8.0 (RiskManager.mqh)
#
# max_trades_per_day = 0 означает БЕЗ ОГРАНИЧЕНИЯ: бот отрабатывает всю
# торговую сессию, сколько бы сделок ни набралось. Само по себе ограничение
# по ЧИСЛУ сделок ничего не защищает — деньги защищают дневной лимит убытка
# (daily_loss_limit_pct) и лимит просадки (max_drawdown_pct). Впишите любое
# число, если всё же захотите ограничить количество.
#
# max_open_positions — это НЕ дневной лимит, а сколько сделок держать
# ОДНОВРЕМЕННО. Он остаётся: без него один сигнал мог бы открыть десятки
# позиций сразу и превысить совокупный риск на счёте.
# Денежная цель прибыли на сделку — В ПРОЦЕНТАХ ОТ СЧЁТА, а не в долларах.
#
# В профилях ниже цель записана абсолютным числом (target_profit_money).
# Абсолютные суммы не переживают смену размера депозита: у «Истерички» стоит
# 1.0, и на счёте $65 это полтора процента, а на $1000 — одна десятая
# процента. Чем больше счёт, тем больше объём при том же проценте риска, тем
# меньше движения цены нужно, чтобы «заработать доллар», — и цель прибыли
# сжимается до пары пунктов, которые съедает спред.
#
# 0 = выключить и вернуться к абсолютным числам из профилей.
# Цель никогда не становится МЕНЬШЕ абсолютной: берётся большее из двух.
#
# Сейчас на это ничего не опирается: при USE_MAX_PROFIT_RIDE = True сделка
# открывается вообще без цели прибыли. Настройка нужна на случай, когда этот
# режим выключат — особенно после пополнения счёта.
TARGET_PROFIT_PERCENT_OF_EQUITY = 0.5

RISK_PROFILES = {
    RiskProfile.CONSERVATIVE: dict(
        risk_percent=0.3, atr_sl_multiplier=2.5, use_money_tp=True, target_profit_money=2.0,
        min_score_to_trade=70, max_open_positions=1, max_trades_per_day=0,
        daily_loss_limit_pct=2.0, max_drawdown_pct=6.0, max_total_risk_pct=0.5,
        ignore_soft_filters=False, hedge_both_directions=False, name="Консервативный",
    ),
    RiskProfile.BALANCED: dict(
        risk_percent=0.7, atr_sl_multiplier=2.5, use_money_tp=True, target_profit_money=4.0,
        min_score_to_trade=62, max_open_positions=2, max_trades_per_day=0,
        daily_loss_limit_pct=3.0, max_drawdown_pct=10.0, max_total_risk_pct=1.8,
        ignore_soft_filters=False, hedge_both_directions=False, name="Сбалансированный",
    ),
    RiskProfile.AGGRESSIVE: dict(
        risk_percent=1.2, atr_sl_multiplier=2.0, use_money_tp=True, target_profit_money=8.0,
        min_score_to_trade=55, max_open_positions=5, max_trades_per_day=0,
        daily_loss_limit_pct=5.0, max_drawdown_pct=15.0, max_total_risk_pct=6.5,
        ignore_soft_filters=False, hedge_both_directions=False, name="Агрессивный",
    ),
    RiskProfile.HYSTERIC: dict(
        risk_percent=0.1, atr_sl_multiplier=1.5, use_money_tp=True, target_profit_money=1.0,
        min_score_to_trade=45, max_open_positions=10, max_trades_per_day=0,
        daily_loss_limit_pct=8.0, max_drawdown_pct=25.0, max_total_risk_pct=3.0,
        ignore_soft_filters=True, hedge_both_directions=False, name="Истеричка (YOLO)",
        # ОТКЛЮЧЕНО по факту реальных сделок пользователя (скриншот: обе ноги
        # хеджа теряли на спреде во флэте, напр. nzdjpys buy -100.56/sell -100.55
        # ОБЕ в минусе одновременно) — хедж гарантированно платит двойной спред,
        # а выигрывает только когда рынок УЖЕ явно направлен, что противоречит
        # самой идее "подстраховаться в обе стороны". Раньше было True по просьбе
        # пользователя, теперь выключено по его же решению после реальных убытков.
        # hedge_both_directions: при срабатывании сигнала открывались СРАЗУ ОБЕ
        # стороны (BUY и SELL), а не одна по большему score. У каждой ноги —
        # ОБЫЧНЫЙ SL/TP/BE/трейлинг/Profit Lock, как у любой сделки: убыточная
        # нога ограничена своим стоп-лоссом, прибыльная закрывается как обычно.
        # См. process_symbol() в main.py. Переключатель остался (можно включить
        # обратно вручную на вкладке "Настройка", поле "Хедж: ...").
        #
        # min_score_to_trade: поднят с 30 до 45 — по факту тех же реальных сделок:
        # порог 30 из 100 пропускал почти любой шум, из-за чего BUY и SELL score
        # часто проходили фильтр почти одновременно (слабые, некачественные
        # сигналы с обеих сторон). 45 всё ещё намного мягче Агрессивного (55) и
        # Сбалансированного (62) — частота сделок остаётся высокой, но отсекает
        # сигналы нулевого качества.
    ),
}


# =====================================================================
# РЕЖИМ ТОРГОВЛИ — на выбор, как в MQL5 v8.0 (п.24)
# =====================================================================
class TradingMode(Enum):
    SCALPING = "scalping"          # откат+пробой, новости избегаются (насколько позволяет news_calendar.py)
    NEWS_TRADING = "news_trading"  # вход на пробой после важной новости (нужен источник календаря, см. NEWS_PROVIDER_CHAIN)
    BOTH = "both"                  # новостной вход в приоритете, иначе скальпинг

# BOTH = новостной вход В ПРИОРИТЕТЕ, а когда свежей новости нет — обычный
# скальпинг. Это ДОБАВЛЯЕТ новостную торговлю, ничего не отнимая: раньше
# стояло SCALPING, и ветка новостей не выполнялась вовсе — сколько бы ни было
# настроено источников и порогов, новостных входов не происходило никогда.
# NEWS_TRADING = только новости (в остальное время бот молчит).
TRADING_MODE = TradingMode.BOTH

# Какие новости считаются поводом для ВХОДА в новостном режиме:
#   "high"   — только самые важные (NFP, ставки, CPI).
#   "medium" — плюс средние. ПО УМОЛЧАНИЮ: владелец просил отрабатывать
#              каждую новость. Средние новости двигают рынок слабее, а
#              спред на них расширяется так же — сделок станет заметно
#              больше, и не все они будут удачными.
#   "low"    — вообще всё подряд; для торговли смысла почти нет.
# На вкладку «Новости» это не влияет — там видны все события в любом случае.
NEWS_TRADE_MIN_IMPACT = "medium"

NEWS_BREAKOUT_WINDOW_MIN = 15        # окно ПОСЛЕ важной новости, где ловим пробой (режим NEWS_TRADING/BOTH)
NEWS_BREAKOUT_MIN_BODY_PCT = 55
NEWS_VOLATILITY_SL_BOOST = 1.5
# 0 = БЕЗ ПАУЗЫ на новостях. Было 30: за полчаса до важной новости и полчаса
# после бот не входил вовсе — на вкладке «Календарь» это и показывалось как
# «ближайшая пауза». Теперь он работает и в это время. От самого выброса цены
# защищает USE_VOLATILITY_SPIKE_GUARD: он не ждёт, а пропускает конкретную
# сделку, если свеча аномально длинная.
NEWS_HARD_BLOCK_WINDOW_MIN = 0       # окно ДО/ПОСЛЕ важной новости, где НОВЫЕ сделки жёстко блокируются
# Мягкий штраф — НЕ пауза: он ничего не ждёт и ничего не блокирует, а просто
# делает отбор сигнала строже рядом с новостью. Поэтому у него своё окно: если
# бы он делил окно с жёсткой блокировкой, снятие паузы заодно отключило бы и
# его — а это разные вещи.
NEWS_SOFT_PENALTY_WINDOW_MIN = 30    # окно ДО/ПОСЛЕ новости, где действует штраф score
NEWS_SOFT_PENALTY_POINTS = 8.0       # сколько баллов score вычитать, если рядом MODERATE-новость (не блокирует)


# =====================================================================
# ЧАСЫ ТОРГОВЛИ — опционально; по умолчанию торгуем круглосуточно
# =====================================================================
USE_TRADING_HOURS = False
TRADING_START_HOUR = 8    # 0-23, время сервера MT5
TRADING_END_HOUR = 20     # 0-23, время сервера MT5 (может быть меньше START — тогда диапазон через полночь)


# =====================================================================
# ЛОТ — фолбэк / ручной режим (используется, если риск-расчёт недоступен,
# либо если явно выключен риск-расчёт по проценту эквити)
# =====================================================================
USE_RISK_BASED_LOT = True   # True = лот считается по risk_percent профиля (рекомендуется). False = всегда LOT_FALLBACK.
LOT_FALLBACK = 0.01

# =====================================================================
# ИСТОЧНИК НОВОСТЕЙ (news_providers.py) — универсально, можно добавлять провайдеров
# =====================================================================
# MT5 через Python не даёт собственный календарь, поэтому новости берутся из
# внешнего API. Провайдер и ключ удобнее всего задать на вкладке "Новости" в
# desktop-приложении — она сама впишет сюда нужные строки. Пока ключ не задан,
# всё работает как раньше: fail-open (новости не блокируют и не влияют).
USE_NEWS_FILTER = True
NEWS_API_PROVIDER = "finnhub"     # см. news_providers.PROVIDERS — сюда можно вписать любой добавленный провайдер
NEWS_API_KEYS = {"finnhub": ""}

# Цепочка источников календаря: берём первый, который ответил.
#
# "mt5"     — ВСТРОЕННЫЙ календарь MetaTrader 5. Бесплатно, без ключа, без
#             лимитов. Требует, чтобы в терминале был запущен сервис
#             CalendarExport (Навигатор -> Сервисы), см.
#             install/Install-CalendarExport.ps1.
# "finnhub" — сторонний API, нужен бесплатный ключ с finnhub.io. Работает,
#             даже когда терминал закрыт, но упирается в лимиты тарифа.
#
# Вместе они закрывают слабые места друг друга. Пустой список событий НЕ
# считается отказом (на выходных новостей и правда нет) — переключение на
# следующий источник происходит только при ошибке.
# Порядок источников: первый ответивший и используется. mt5 — встроенный
# календарь терминала (нужен запущенный сервис CalendarExport), forexfactory —
# бесплатный и без ключа, работает сразу, finnhub — запасной, нужен ключ.
NEWS_PROVIDER_CHAIN = ["mt5", "forexfactory", "finnhub"]

# Календарь сам подтягивает свежие новости раз в столько минут — открывать
# вкладку и жать «Обновить календарь» руками не нужно. 0 = не обновлять само.
# Источник (сервис MT5 или API) от этого не нагружается: события меняются
# редко, чаще раза в 10 минут спрашивать незачем.
NEWS_AUTO_REFRESH_MINUTES = 15


# =====================================================================
# ИНДИКАТОРЫ
# =====================================================================
EMA_FAST_PERIOD = 20
EMA_SLOW_PERIOD = 50
EMA_TREND_PERIOD = 200
ADX_PERIOD = 14
RSI_PERIOD = 14
ATR_PERIOD = 14
ATR_AVG_PERIOD = 20

ADX_MIN_LEVEL = 25
RSI_OVERBOUGHT = 70
RSI_OVERSOLD = 30


# =====================================================================
# PULLBACK + PRICE ACTION (Indicators.mqh)
# =====================================================================
PULLBACK_TOLERANCE_POINTS = 50   # авто-масштабируется под ATR, см. AUTO_ADAPT_TO_SYMBOL
BODY_PERCENT_MIN = 60
MAX_WICK_PERCENT = 30

# =====================================================================
# ОБЪЁМ — мягкий, необязательный фильтр (тиковый объём из copy_rates)
# =====================================================================
USE_VOLUME_FILTER = False   # по умолч. ВЫКЛ, как и в MQL5-версии: тиковый объём ненадёжен на XAU/индексах
VOLUME_AVG_PERIOD = 20


# =====================================================================
# АВТОНАСТРОЙКА ПОД ИНСТРУМЕНТ (п.24) — критично для мульти-парного бота!
# =====================================================================
# Один "пункт" означает разное на золоте/форексе/крипте. Если включено — пороги
# пересчитываются как доля от ATR КАЖДОГО конкретного инструмента, а не
# фиксированное число пунктов. См. risk_manager.eff_points_threshold().
AUTO_ADAPT_TO_SYMBOL = True


# =====================================================================
# ЖЁСТКИЕ ЗАЩИТНЫЕ ПРОВЕРКИ
# =====================================================================
# ПАУЗ БОЛЬШЕ НЕТ НИ ОДНОЙ. Владелец попросил убрать все ожидания: бот не
# должен пропускать время, что бы ни происходило. Ниже — что было выключено.
#
# MIN_BARS_BETWEEN_REVERSAL = 0
#   Было 2: после закрытой сделки бот ждал два бара, прежде чем войти в
#   ПРОТИВОПОЛОЖНУЮ сторону. Защищало от «дребезга» — метаний туда-сюда на
#   одном и том же движении. Теперь разворот возможен сразу.
MIN_BARS_BETWEEN_REVERSAL = 0

# Эти две проверки — НЕ паузы: они ничего не ждут, а смотрят на конкретную
# сделку прямо сейчас. Именно они и остаются вместо снятых пауз.
USE_SPREAD_FILTER = True        # спред слишком широкий -> эту сделку не берём
MAX_SPREAD_POINTS = 200         # авто-масштабируется (доля ATR), см. AUTO_ADAPT_TO_SYMBOL
USE_VOLATILITY_SPIKE_GUARD = True   # свеча аномально длинная -> эту сделку не берём
VOLATILITY_SPIKE_MULTIPLIER = 2.5

# USE_ROLLOVER_GUARD = False
#   Было True: вокруг полуночи брокера (±15 минут) торговля вставала. В этот
#   момент брокеры пересчитывают своп и спред расширяется в разы.
#   Теперь пауза снята — от широкого спреда защищает USE_SPREAD_FILTER выше:
#   он не ждёт, а просто не даёт открыть сделку по плохой цене.
USE_ROLLOVER_GUARD = False
ROLLOVER_HOUR_SERVER = 0
ROLLOVER_GUARD_MINUTES = 15     # действует, только если снова включить проверку

# ВНИМАНИЕ про USE_ROLLOVER_GUARD выше: на профиле «Истеричка»
# (ignore_soft_filters = True — он выбран по умолчанию) эта проверка
# ОТКЛЮЧАЕТСЯ профилем и не работает, сколько её ни включай. Там же
# отключаются volatility_ok и spread_cost_ok. Проверка «рынок закрыт»
# ниже сделана иначе — её профиль отменить не может.


# =====================================================================
# РЫНОК ЗАКРЫТ ИЛИ НЕЛИКВИДЕН — спрашиваем у рынка, а не у часов
# =====================================================================
# Владелец: «не по моему времени, а когда именно рынок закрыт».
#
# Почему часы для этого не годятся. Время компьютера и время сервера
# брокера расходятся на 2-3 часа, летом и зимой по-разному, а у разных
# брокеров по-разному вдобавок. Окно, заданное часами, легко промахивается
# мимо цели целиком. И главное: час — не причина убытка, причина —
# состояние рынка.
#
# Три признака, все берутся из самого рынка (см. market_hours.py):
#   1) брокер закрыл торговлю по инструменту (trade_mode);
#   2) цена не обновляется дольше MARKET_DEAD_SECONDS — выходной,
#      технический перерыв, мёртвый инструмент;
#   3) спред намного шире ОБЫЧНОГО ДЛЯ ЭТОЙ ЖЕ ПАРЫ — рынок неликвиден.
#
# Это НЕ остановка бота: запрещается только ВХОД и только по той паре, где
# признак сработал. Открытые сделки продолжают вестись — трейлинг,
# безубыток, частичное закрытие работают как обычно.
#
# Действует ВСЕГДА, включая профиль «Истеричка»: именно на нём получены
# ночные убытки, и позволить профилю отменить эту проверку означало бы
# сделать её бессмысленной.
USE_MARKET_CLOSED_GUARD = True
MARKET_DEAD_SECONDS = 90        # цена стоит дольше -> рынок закрыт

# Неликвидность. Порог задан ОТНОШЕНИЕМ к собственной медиане спреда этой
# пары, а не числом пунктов: у каждого инструмента и каждого брокера свой
# нормальный спред, и абсолютный порог пришлось бы подбирать вручную под
# каждую пару. 2.5 = «шире обычного в два с половиной раза».
#
# ЧЕСТНО ПРО ОБОСНОВАНИЕ. Ночная просадка в отчёте владельца посчитана
# (-20.66 за 22 сделки при итоге счёта -19.99). А вот то, что виноват
# именно спред, — механизм, а не измерение: спреды в отчёте MT5 не
# записываются, проверить задним числом не по чему. Механизм известный
# (ночью ликвидность уходит, спред расширяется), но числом не доказан.
USE_THIN_MARKET_GUARD = True
THIN_SPREAD_RATIO = 2.5
THIN_MIN_SAMPLES = 30           # пока замеров меньше — не судим


# Общий потолок числа ОДНОВРЕМЕННО открытых сделок по ВСЕМ парам.
# 0 = без ограничения.
#
# max_open_positions в профиле считает сделки ПО ОДНОМУ символу: при десяти
# настроенных парах это до ста позиций одновременно, и единственной общей
# границей остаётся max_total_risk_pct. В отчёте владельца одновременно
# бывало до 9 открытых сделок.
#
# По умолчанию ВЫКЛЮЧЕНО (0): владелец предпочитает больше сделок ради
# доходности — то же решение он принял по потолку плеча. Поставьте 4-5,
# если захотите ограничить.
MAX_SIMULTANEOUS_POSITIONS = 0


# =====================================================================
# ВНЕШНИЙ AI-СИГНАЛ (Claude/OpenAI, встроено напрямую — без отдельного Flask-моста)
# =====================================================================
USE_AI_SIGNAL = True
AI_PROVIDER = "claude"          # "claude" или "openai"
AI_SIGNAL_WEIGHT = 10           # макс. баллов, которые сигнал может добавить/вычесть
AI_SIGNAL_CACHE_SECONDS = 60    # не спрашивать AI чаще раза в минуту (те же соображения, что и в EA)
AI_SIGNAL_REQUIRE_DIRECTION = False
AI_SIGNAL_TIMEOUT_MS = 3000     # таймаут запроса к Claude/OpenAI, мс

ANTHROPIC_API_KEY = ''  # впишите через интерфейс программы
OPENAI_API_KEY = ''


# =====================================================================
# СОБСТВЕННАЯ СТРАТЕГИЯ ПРОГРАММЫ (custom_strategy.py) — только в этом
# Python-боте, НЕ в MQL5-советнике (по явной просьбе пользователя). Второе,
# независимое мнение (momentum/ускорение/согласованность/расширение
# диапазона), подмешивается в score с ограниченным весом, как AI-сигнал.
# Веса и формулы — в custom_strategy.py (версионируется там же, обновляй
# constants там при доработке стратегии).
# =====================================================================
# =====================================================================
# ГОТОВАЯ СТРАТЕГИЯ (strategies.py) — выбирается на вкладке "Быстрый старт"
# =====================================================================
# Стратегия добавляет своё мнение к общей оценке сигнала. Она только
# ДОБАВЛЯЕТ баллы и не может протолкнуть сделку в обход остальных
# фильтров и лимитов риска.
# =====================================================================
# ВХОД В ПРОГРАММУ
# =====================================================================
# False — программа открывается сразу, без экрана входа. Удобно, но
# защита паролем при этом не работает: любой, кто получил доступ к
# компьютеру, откроет программу и увидит счета.
# Зашифрованные ключи (AI, пароль MT5) при пропуске входа открываются
# только сохранённым паролем («Запомнить пароль» на экране входа).
REQUIRE_LOGIN = False


# =====================================================================
# ПРИВАТНЫЙ РЕЖИМ — секреты открытым текстом в закрытом репозитории
# =====================================================================
# True  — ключи и пароли пишутся в этот файл КАК ЕСТЬ, без шифрования.
#         Пароль входа для их чтения не нужен.
# False — секреты шифруются паролем входа (см. secure_store.py).
#
# ЗАЧЕМ ЭТО ЕСТЬ. Шифрование держится на пароле входа. Как только вход
# отключён (REQUIRE_LOGIN = False), получается тупик: ключи в файле есть,
# а открыть их нечем. Приватный режим убирает тупик честно — не делает вид,
# что шифрует, а прямо говорит: защита теперь одна, это закрытый
# репозиторий и ваш компьютер.
#
# ВКЛЮЧАТЬ ТОЛЬКО ЕСЛИ РЕПОЗИТОРИЙ УЖЕ ПРИВАТНЫЙ.
# Проще всего через install/enable-private-mode.bat — он переспросит и
# заодно поправит .gitignore, чтобы config.py начал сохраняться в git.
#
# ЧЕГО ЭТОТ РЕЖИМ НЕ МЕНЯЕТ: telegram_session (доступ к вашему Telegram),
# accounts.json, журналы и CSV сделок остаются вне git ВСЕГДА. Закрытый
# репозиторий — не повод класть туда живые пропуска.
PRIVATE_MODE = False


ACTIVE_STRATEGY = "balanced_hybrid"   # balanced_hybrid | trend_follow | mean_reversion | breakout | careful_scalp
USE_STRATEGY_SIGNAL = True            # учитывать мнение стратегии в score
STRATEGY_SIGNAL_WEIGHT = 12           # макс. баллов, которые стратегия может добавить

USE_CUSTOM_STRATEGY = True
CUSTOM_STRATEGY_WEIGHT = 15   # макс. баллов, которые стратегия может добавить/вычесть


# =====================================================================
# ДОПОЛНИТЕЛЬНОЕ ПОДТВЕРЖДЕНИЕ КЛАССИЧЕСКИМИ ИНДИКАТОРАМИ (multi_indicator.py)
# По просьбе пользователя "используй как можно больше индикаторов и торговых
# стратегий": MACD/Bollinger Bands/Stochastic — третье независимое мнение,
# подмешивается в score с ограниченным весом, как custom_strategy/AI-сигнал.
# Периоды — стандартные общепринятые значения (12/26/9, 20×2σ, 14/3).
# =====================================================================
USE_MULTI_INDICATOR = True
MULTI_INDICATOR_WEIGHT = 12   # макс. баллов, которые эта группа индикаторов может добавить/вычесть
MACD_FAST_PERIOD = 12
MACD_SLOW_PERIOD = 26
MACD_SIGNAL_PERIOD = 9
BB_PERIOD = 20
BB_STD_MULT = 2.0
STOCH_K_PERIOD = 14
STOCH_D_PERIOD = 3


# =====================================================================
# АДАПТАЦИЯ К РЕЖИМУ РЫНКА (MarketRegime.mqh)
# =====================================================================
USE_MARKET_REGIME_FILTER = True
REGIME_ER_PERIOD = 10
REGIME_ADX_TREND_LEVEL = 25
REGIME_ADX_RANGE_LEVEL = 18
REGIME_ER_TREND_LEVEL = 0.5
REGIME_ER_RANGE_LEVEL = 0.25
REGIME_CONFIRM_BARS = 3
# "Умнее" score (см. signal_engine.py): в подтверждённом тренде усиливает вес
# Тренд+Откат компонентов (структурные сигналы надёжнее), во флэте усиливает
# вес RSI (мин-реверсия полезнее, когда рынок не трендует). Выключи, чтобы
# вернуть исходные фиксированные веса (Тренд20/Откат20/.../RSI5).
USE_ADAPTIVE_SCORE_WEIGHTS = True
REGIME_RANGE_PENALTY = 15
REGIME_TREND_BONUS = 5

# Анти-"зеркало" фильтр #1 (жалоба пользователя: "каждую сделку открывает в
# зеркале" — входит и тут же разворачивается). Раньше подтверждение свечи
# (price action) было лишь мягким бонусом +15 к score, вход был возможен и
# без него. Если ВКЛ — без подтверждающей свечи score для этого направления
# принудительно = 0 (см. calc_signal_score() в signal_engine.py).
USE_PA_HARD_GATE = True

# Анти-"зеркало" фильтр #2 (по факту жалобы пользователя "бот открывает в
# зеркало" — входит и тут же рынок разворачивается): раньше ФЛЭТ только
# штрафовал score (REGIME_RANGE_PENALTY), сделка всё равно была возможна.
# Если ВКЛ — вход ПОЛНОСТЬЮ блокируется, пока режим не сменится на тренд/
# неопределённый (см. process_symbol в main.py). Действует всегда, включая
# профили с ignore_soft_filters ("Истеричка").
BLOCK_ENTRY_IN_RANGE = True

# Анти-"зеркало" фильтр #3: сигнальная свеча уже слишком растянута относительно
# среднего ATR — движение, скорее всего, уже во многом прошло/истощилось,
# именно такие свечи чаще всего разворачиваются сразу после входа. См.
# _candle_overextended() в signal_engine.py.
USE_EXHAUSTION_FILTER = True
EXHAUSTION_RANGE_ATR_RATIO = 2.0   # диапазон свечи > этого × средний ATR -> вход блокируется


# =====================================================================
# КОНТЕКСТ РЫНКА — сверка с коррелирующими инструментами (MarketContext.mqh)
# =====================================================================
# Ключ = наш символ (как в SYMBOLS), значение = список (символ_контекста, корреляция)
# корреляция: "positive" или "negative" (напр. DXY отрицательно коррелирует с золотом)
MARKET_CONTEXT = {
    # У брокера SwitchMarkets-Live в списке символов нет индекса доллара (USDX/DXY),
    # поэтому слот контекста пока пуст. Если найдёшь у брокера что-то похожее — впиши сюда.
    "XAUUSDs": [],
}
USE_MARKET_CONTEXT = False  # включи, когда впишешь реальные символы контекста своего брокера
CONTEXT_EMA_PERIOD = 50
CONTEXT_SCORE_WEIGHT = 10


# =====================================================================
# SCORE — единый фильтр входа
# =====================================================================
USE_SCORE_FILTER = True
# Веса: Тренд20 Откат20 PriceAction15 ATR10 ADX10 Спред5 Время5 RSI5 = 90
# (Volume10 из MQL5-версии не переносим — тиковый объём в Python-MT5 доступен
# так же ограниченно, как и в MQL5, и по умолчанию был выключен там же)


# =====================================================================
# СТОПЫ / TP
# =====================================================================
RISK_REWARD_RATIO = 3.0   # по просьбе пользователя: TP x3 против SL x1 (было 1.2 — слишком мало)
TP_MIN_POINTS = 50     # авто-масштабируется (доля ATR); не используется, пока USE_MAX_PROFIT_RIDE=True
TP_MAX_POINTS = 1000   # авто-масштабируется (доля ATR); не используется, пока USE_MAX_PROFIT_RIDE=True

# КРИТИЧНО (по факту реальных сделок пользователя — TP всего +$1 против SL
# -$100+, счёт в минусе): TP НИКОГДА не может быть меньше, чем SL, умноженный
# на этот коэффициент — независимо от профиля/фиксированной денежной цели
# прибыли (target_profit_money). Раньше денежные цели профилей (особенно
# "Истеричка" — $1) никак не были привязаны к фактическому долларовому риску
# на сделку (который растёт вместе с эквити) — из-за этого одна убыточная
# сделка "съедала" множество мелких прибыльных. Теперь калькулятор TP
# (risk_manager.calc_tp_distance / calc_tp_distance_money) всегда поднимает
# TP минимум до SL × MIN_RISK_REWARD_RATIO, если посчитанный TP оказался
# меньше. См. также USE_MAX_PROFIT_RIDE выше — пока он включён, TP вообще не
# ставится (сделку ведёт трейлинг), и это ограничение неактуально; но как
# только USE_MAX_PROFIT_RIDE выключат — данная защита не даст повторить
# прежнюю ошибку.
MIN_RISK_REWARD_RATIO = 3.0

# По просьбе пользователя — "тянуть максимальную прибыль, сколько возможно":
# сделка открывается БЕЗ фиксированного TP (ни в пунктах, ни в деньгах) — вместо
# этого её полностью ведут Break Even + ATR-трейлинг + Profit Lock ниже: они
# постепенно поднимают стоп-лосс вслед за ценой, а закрытие происходит только
# когда цена разворачивается и выбивает этот подтянутый стоп. Так позиция может
# забрать любую прибыль, какую даст движение рынка, а не только фиксированную
# небольшую цель. Выключи (False), чтобы вернуть прежнее поведение с TP_* /
# RISK_REWARD_RATIO / target_profit_money (см. process_symbol в main.py).
USE_MAX_PROFIT_RIDE = True

USE_BREAK_EVEN = True
BREAK_EVEN_ATR_MULTIPLIER = 1.0
BREAK_EVEN_OFFSET_POINTS = 10   # авто-масштабируется

USE_TRAILING_STOP = True
TRAILING_ATR_MULTIPLIER = 1.2
TRAILING_MIN_POINTS = 40        # авто-масштабируется
TRAILING_STEP_MIN_POINTS = 5    # авто-масштабируется

USE_PROFIT_LOCK_TRAILING = True
PROFIT_LOCK_START_POINTS = 20   # авто-масштабируется
PROFIT_LOCK_PERCENT = 50

# =====================================================================
# ЛЕСТНИЦА ТРЕЙЛИНГА В ЕДИНИЦАХ РИСКА СДЕЛКИ (R) — "подтягивай стоп раньше"
# =====================================================================
# R — это собственный риск ЭТОЙ сделки: расстояние от входа до её стопа.
# Не ATR, не пункты, а «сколько сделка может максимум потерять». Одна и та
# же ступенька поэтому одинаково понятна на золоте и на EURUSD.
#
# ОТКУДА ЧИСЛА. Отчёт владельца за 06-07.08.2026, 211 сделок, счёт $65:
#     стоп успел уйти в плюс -> 74 сделки, +89.56
#     стоп остался в минусе  -> 137 сделок, -109.55
# Живут обе группы одинаково (медиана 6.6 и 6.5 минуты). Весь минус счёта —
# это сделки, где защита не успела включиться. А включалась она не раньше
# 0.67R (безубыток), 0.80R (ATR-трейлинг) и 1.00R (Profit Lock), причём
# отступ ATR-трейлинга (0.80R) был почти равен самому стопу — подтянувшись,
# он всё равно отдавал назад почти всю дистанцию.
#
# Лестница читается так: «пик прибыли дошёл до X риска — запираем стопом Y
# риска». Первая ступенька 0.30 / 0.00 = прошли треть своего риска, стоп
# переезжает в безубыток. Дальше стоп только поднимается, вниз он не ходит
# никогда — это запрещено в самом коде (_better_sl), а не настройкой.
USE_R_TRAIL_LADDER = True
R_TRAIL_LADDER = [
    (0.30, 0.00),   # пик +0.30R -> стоп в безубыток
    (0.60, 0.20),   # пик +0.60R -> заперто +0.20R
    (1.00, 0.45),   # пик +1.00R -> заперто +0.45R
    (1.50, 0.85),
    (2.50, 1.60),
]
# Сколько R разрешено отдать от пика. Работает поверх лестницы и только
# ПОДНИМАЕТ фиксацию: на сильном движении стоп идёт за ценой, не дожидаясь
# следующей ступеньки. 0 — выключить и жить строго по ступенькам.
R_TRAIL_GIVEBACK_R = 0.5

# Частичное закрытие позиции при достижении профита (один раз за сделку).
# Половина объёма забирается в плюс, остаток продолжает идти под трейлингом
# и Profit Lock: часть прибыли зафиксирована в любом случае, а разворот
# забирает уже меньше.
#
# ВАЖНО ПРО МАЛЕНЬКИЙ ЛОТ. Закрыть можно только объём, кратный шагу лота
# брокера, и не меньше его минимума (обычно 0.01). Если сделка открыта
# минимальным лотом 0.01, половина от неё — 0.005, а такой сделки не
# существует: частичное закрытие в этом случае НЕВОЗМОЖНО физически, и
# программа честно пишет об этом в лог, а не делает вид, что сработало.
# Работать оно начинает с лота 0.02 и больше.
USE_PARTIAL_CLOSE = True
PARTIAL_CLOSE_TRIGGER_POINTS = 150   # авто-масштабируется (доля ATR)
PARTIAL_CLOSE_PERCENT = 50           # % объёма закрыть частично


# =====================================================================
# ПОДТЯГИВАНИЕ ТЕЙК-ПРОФИТА — "чаще фиксировать прибыль, долго не сидеть"
# =====================================================================
# Тейк-профит можно только ПРИБЛИЖАТЬ к цене, никогда не отодвигать дальше —
# то же правило, что и для стоп-лосса. Отодвинутый TP означает, что сделка
# висит дольше и дольше подставляется под разворот; приближённый — только
# ускоряет фиксацию.
#
# Работает и при USE_MAX_PROFIT_RIDE = True: сделка по-прежнему открывается
# без TP, но как только цель становится понятна (из ATR или из выученной
# статистики), TP ставится и дальше только поджимается.
USE_TP_TIGHTEN = True
TP_TIGHTEN_START_ATR = 1.5          # стартовая цель прибыли = ATR × это
# Владелец: «и тейк-профит, закрывать чаще плюсовые сделки».
# Было 0.10 (10% в минуту) и пол 0.25. По отчёту медиана жизни сделки — 6.5
# минуты, то есть за типичную сделку цель успевала ужаться всего на ~48% и
# почти всегда упиралась не в этот пол, а в TP_TIGHTEN_MIN_R ниже. Подняли
# до 18% в минуту: к тем же 6.5 минуты цель ужимается до ~30% стартовой, и
# сделка забирает то, что уже дал рынок, а не ждёт полной цели.
TP_TIGHTEN_SHRINK_PER_MINUTE = 0.18 # за каждую минуту жизни сделки цель ужимается на 18%
TP_TIGHTEN_MIN_FRACTION = 0.20      # но не ниже 20% стартовой цели
TP_TIGHTEN_MIN_PROFIT_POINTS = 10   # авто-масштабируется; TP всегда остаётся в плюсе от входа
TP_TIGHTEN_STEP_POINTS = 5          # авто-масштабируется; мельче — не дёргаем сервер
# КРИТИЧНО: цель прибыли не может стать меньше собственного риска сделки,
# умноженного на это число. 1.0 = цель всегда покрывает хотя бы свой стоп.
#
# Без этого пола сжатие цели со временем делало сделку убыточной по
# математике: у профиля "Истеричка" стоп равен 0.5*ATR, а цель ужималась до
# 0.375*ATR — риск больше выигрыша, и при обычном винрейте это гарантированный
# минус. Поднимите до 1.5-2.0, если хотите более осторожное соотношение.
#
# ЭТО ЕДИНСТВЕННОЕ, ЧТО НЕ БЫЛО ОСЛАБЛЕНО под просьбу «закрывать чаще
# плюсовые сделки», и вот почему. В отчёте за 06-07.08.2026 сделки, у
# которых цель стояла БЛИЖЕ собственного стопа, дали -2.53 при винрейте
# 43%. При таком винрейте выигрыш обязан быть больше проигрыша, иначе минус
# гарантирован арифметикой, а не рынком. Скорость поджима (выше) ускорять
# безопасно, этот пол — нет.
TP_TIGHTEN_MIN_R = 1.0

# Спасение убыточной сделки в безубыток.
# Сделка, которая заметно ушла в минус и вернулась к нулю, уже показала, что
# вход был неудачным. Такую разумнее отпустить в ноль, чем ждать полной цели.
#
# ЧЕГО ЭТО НЕ ДЕЛАЕТ: не трогает стоп-лосс, не отодвигает и не отменяет его.
# Это только ДОПОЛНИТЕЛЬНЫЙ выход раньше. Если рынок не вернёт сделку к нулю,
# её закроет обычный стоп-лосс на своей исходной дистанции.
USE_BREAK_EVEN_RESCUE = True
BE_RESCUE_MIN_DRAWDOWN_POINTS = 20  # авто-масштабируется; насколько глубоко надо было просесть
BE_RESCUE_AFTER_MINUTES = 10        # и сколько провисеть, прежде чем включится спасение
BE_RESCUE_EXIT_POINTS = 3           # авто-масштабируется; "ноль" с запасом на спред и комиссию


# =====================================================================
# ПРОСАДКА / СЕРИИ УБЫТКОВ
# =====================================================================
# ТОРГОВЛЯ НЕ ОСТАНАВЛИВАЕТСЯ. Владелец программы попросил убрать все условия,
# которые ВЫКЛЮЧАЮТ бота на остаток дня или на время: он должен отрабатывать
# всю торговую сессию.
#
# Что именно выключено и что это раньше делало:
#   USE_DAILY_LOSS_LIMIT            — молчал до завтра, поймав неудачное утро;
#   USE_MAX_DRAWDOWN_LIMIT          — молчал до перезапуска после просадки;
#   PAUSE_MINUTES_AFTER_LOSS_STREAK — молчал по паре после серии убытков.
# Любое из них включается обратно в один щелчок: вкладка Настройка -> Риск,
# группа «Просадка / серии убытков». Ноль в daily_loss_limit_pct и
# max_drawdown_pct тоже означает «порога нет».
#
# ЧЕМ ЗАЩИЩЕНЫ ДЕНЬГИ ТЕПЕРЬ. Это не отмена защиты, а смена её вида: раньше
# бота останавливали ПОСЛЕ убытков, теперь ограничивается РАЗМЕР каждого
# убытка. Работает на каждой сделке, а не постфактум:
#   * стоп-лосс обязателен — сделка без него не открывается вообще;
#   * стоп не может оказаться внутри спреда и шума (MIN_SL_SPREAD_MULTIPLE,
#     MIN_SL_ATR_FRACTION) — именно из-за этого сделки умирали за 8-11 секунд;
#   * риск на сделку в процентах от эквити (risk_percent в профиле);
#   * лимит совокупного риска по всем открытым сразу сделкам
#     (max_total_risk_pct) — сколько бы сделок ни было, суммарный риск
#     ограничен;
#   * снижение риска по мере серии убытков (USE_LOSS_STREAK_RISK_SCALING):
#     бот не останавливается, но входит меньшим объёмом.
#
# ЧЕГО ЖДАТЬ. Без остановок счёт может уйти в просадку глубже, чем раньше:
# ограничение осталось только на ОДНУ сделку, но не на их количество за день.
# Держите риск на сделку небольшим и следите за журналом в облаке.
USE_DAILY_LOSS_LIMIT = False
USE_MAX_DRAWDOWN_LIMIT = False
MAX_CONSECUTIVE_LOSSES = 5     # порог для снижения риска; паузу больше не ставит
# Пауза по ПАРЕ после серии убытков, МИНУТ. 0 = паузы нет, торговля не
# прерывается. Вместо паузы работает USE_LOSS_STREAK_RISK_SCALING ниже: риск
# плавно снижается по мере серии, а сделки продолжают открываться.
PAUSE_MINUTES_AFTER_LOSS_STREAK = 0
USE_LOSS_STREAK_RISK_SCALING = True
MIN_LOSS_STREAK_RISK_MULTIPLIER = 0.3


# =====================================================================
# ИЗДЕРЖКИ / СОВОКУПНЫЙ РИСК
# =====================================================================
MAX_SPREAD_COST_PERCENT_OF_TP = 30.0
ORDER_RETRY_ATTEMPTS = 3


# =====================================================================
# ЛОГИ
# =====================================================================
LOG_CSV_PATH = "trades_log.csv"
LOG_LEVEL = "INFO"


# =====================================================================
# АВТООБУЧЕНИЕ — бот сам подстраивает вес AI и порог входа по своей статистике
# =====================================================================
# Ничего не решает "с нуля" — просто плавно усиливает то, что уже работает,
# и придерживает то, что в последнее время убыточно. Работает НА КАЖДЫЙ
# символ отдельно, на скользящем окне последних сделок. См. auto_learning.py.
USE_AUTO_LEARNING = True
AUTO_LEARNING_WINDOW = 20          # сколько последних сделок по символу учитываем
AUTO_LEARNING_MIN_TRADES = 5       # пока сделок меньше — используем базовые настройки без подстройки

# --- Самоотключение убыточного инструмента ---
# Инструмент, который за последние сделки стабильно тянул счёт вниз,
# перестаёт торговаться САМ. Это НЕ остановка торговли: остальные
# инструменты работают как обычно — отсекается ровно тот, который приносит
# убыток.
#
# Откуда взялось: по реальному отчёту (148 сделок, депозит 65) ОДИН
# инструмент — золото — дал 85% всех потерь: минус 29.56, почти половину
# счёта, за 37 сделок. Остальные пары в это же время были в плюсе. Заметить
# это можно было только вручную по отчёту.
#
# Отключение не вечное и не требует нажатий: окно скользящее, старые убытки
# из него выпадают, и торговля по инструменту возобновляется сама.
# Порог считается ОТ РАЗМЕРА СЧЁТА: минус 30 при депозите 65 — катастрофа,
# при депозите 10 000 — обычный шум.
USE_SYMBOL_AUTO_OFF = True
SYMBOL_AUTO_OFF_MIN_TRADES = 10    # раньше этого числа сделок не судим
SYMBOL_AUTO_OFF_LOSS_PERCENT = 8.0 # потерял больше % счёта за окно -> отключаем

AI_WEIGHT_MULT_MIN = 0.5           # множитель веса AI-сигнала: минимум (винрейт ~0%)
AI_WEIGHT_MULT_MAX = 1.5           # множитель веса AI-сигнала: максимум (винрейт ~100%)
SCORE_THRESHOLD_ADJUST_MIN = -10   # насколько МОЖНО понизить порог входа (легче), если серия удачная
SCORE_THRESHOLD_ADJUST_MAX = 15    # насколько МОЖНО повысить порог входа (строже), если серия убыточная

# Обучение ЦЕЛИ ПРИБЫЛИ по фактическим сделкам.
# Бот запоминает, на сколько пунктов каждая закрытая сделка успевала уйти в
# плюс ДО разворота, и берёт медиану этих пиков за последние сделки. Медиану,
# а не среднее: одна аномальная сделка на новостях иначе заставила бы бота
# ждать недостижимой цели во всех остальных.
USE_TP_LEARNING = True
TP_LEARN_FRACTION = 0.7            # ставим TP на 70% от медианы пика — успеть выйти ДО разворота
TP_LEARN_MIN_POINTS = 10           # ниже этой цели не опускаемся ни при какой статистике
TP_LEARN_MAX_POINTS = 2000         # и выше этой не поднимаемся

# Сохранять выученное между запусками программы.
# БЕЗ ЭТОГО САМООБУЧЕНИЯ ФАКТИЧЕСКИ НЕТ: окно результатов живёт только в
# памяти процесса, и при каждом запуске бот начинал бы с нуля — то есть
# вечно оставался в фазе "копит данные" и ни разу не доходил до
# AUTO_LEARNING_MIN_TRADES. Файл обычный JSON, его можно открыть блокнотом
# и посмотреть, чему бот научился. Удалить файл = сбросить обучение.
USE_LEARNING_PERSISTENCE = True
LEARNING_STATE_PATH = "learning_state.json"


# =====================================================================
# АВТООБНОВЛЕНИЕ — конфиг применяется на лету, соединение с MT5 держится само
# =====================================================================
# Если поправишь config.py вручную (профиль/пары/пороги и т.д.) — программа
# сама подхватит изменения без перезапуска python main.py (проверяет, менялся
# ли файл, раз в CONFIG_RELOAD_CHECK_SECONDS). Новые символы из SYMBOLS
# подключаются на лету; удаление символа из списка не останавливает уже
# открытые по нему сделки — их менеджмент (BE/трейлинг) продолжает работать.
USE_CONFIG_HOT_RELOAD = True
CONFIG_RELOAD_CHECK_SECONDS = 15

# Если связь с MT5 пропала (терминал закрылся/разлогинился) — сколько раз
# подряд молча ждать перед тем, как попробовать переподключиться самому
# (mt5.initialize() заново), не требуя ручного перезапуска программы.
USE_AUTO_RECONNECT = True
RECONNECT_AFTER_FAILURES = 5

# Синхронизация с историей сделок брокера (MT5 history_deals_get) — раз в
# HISTORY_SYNC_SECONDS подтягивается история закрытых сделок за последние
# HISTORY_SYNC_DAYS дней по ВСЕМ magic number (не только этого бота), чтобы
# статистика/журнал/экспорт в Excel совпадали с реальной историей у брокера,
# включая сделки, открытые вручную в терминале.
HISTORY_SYNC_DAYS = 30
HISTORY_SYNC_SECONDS = 60


# =====================================================================
# ВЕБ-ДАШБОРД — просмотр и управление с телефона по локальной сети
